{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run lint:styles && npx eslint src/app --ext .ts,.html --max-warnings=1000",
    "lint:styles": "npx stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "npx eslint src/app --ext .ts,.html --fix",
    "lint:watch": "npx eslint src/app --ext .ts,.html --watch",
    "test": "cypress",
    "build:instrumented": "ng build --configuration instrumented && node scripts/instrument-build.mjs",
    "serve:build": "node scripts/serve-build.mjs",
    "cypress": "cypress",
    "cypress:open": "cypress open --e2e",
    "cypress:run": "cypress run --e2e",
    "cypress:run:coverage": "ORION_COVERAGE=true cypress run --e2e"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@cypress/code-coverage": "4.0.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-plugin-istanbul": "^8.0.0",
    "cypress": "^15.20.1",
    "cypress-axe": "1.7.0",
    "eslint": "^10.8.1",
    "istanbul-lib-instrument": "^6.0.3",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-scss": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "nyc": {
    "all": false,
    "include": [
      "src/app/**/*.ts"
    ],
    "exclude": [
      "src/**/*.spec.ts",
      "src/**/*.d.ts"
    ],
    "extension": [
      ".ts"
    ],
    "excludeAfterRemap": true,
    "report-dir": "coverage",
    "reporter": [
      "lcov",
      "json-summary",
      "text-summary"
    ]
  }
}
