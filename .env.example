# MONGODB
MONGODB_URL=mongodb://localhost:27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
MONGODB_DATABASE=orion_mail
SEED_LOCAL_TEST_MAILBOXES=false

# ORION INTELLIGENCE SSO
# Set the same random 32+ character value in Orion Intelligence.
ORION_MAIL_SSO_CLIENT_SECRET=change-me-to-a-long-random-secret
ORION_INTELLIGENCE_INTERNAL_URL=http://trusted-web-main:8070
ORION_INTELLIGENCE_PUBLIC_URL=https://try.orionintelligence.org
ORION_MAIL_PUBLIC_URLS=https://mail.orionintelligence.org,http://localhost:4300,http://mail.localhost:4200
ORION_MAIL_SESSION_MAX_AGE_SECONDS=1800
ORION_SSO_TIMEOUT_SECONDS=5

# OUTBOUND SMTP
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_START_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# TRANSLATION (Google Translate-compatible HTTPS endpoint)
TRANSLATION_API_URL=https://translate.googleapis.com/translate_a/single
TRANSLATION_TIMEOUT_SECONDS=20

# WEB
CORS_ALLOWED_ORIGINS=https://mail.orionintelligence.org
ALLOWED_HOSTS=mail.orionintelligence.org,mail.localhost,localhost,127.0.0.1
COOKIE_SECURE=true

# ENCRYPTION
ENCRYPTION_KEY=change-me

# POSTFIX INGEST
INCOMING_MAIL_TOKEN=change-me

# MAIL HYGIENE (rspamd + clamav)
RSPAMD_MILTER_PORT=11332
RSPAMD_UI_PORT=11334
FRESHCLAM_CHECKS=2

# LET'S ENCRYPT
LETSENCRYPT_EMAIL=admin@orionintelligence.org

# CONTAINER USER
APP_UID=1000
APP_GID=1000
