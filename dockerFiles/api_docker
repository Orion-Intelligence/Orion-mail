FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS builder

WORKDIR /build

COPY backend/requirements.txt /build/requirements.txt
RUN pip install --no-cache-dir --prefix=/install --requirement /build/requirements.txt

FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS base

ARG APP_UID=1000
ARG APP_GID=1000

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    HOME=/tmp

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools wheel \
    && groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --no-create-home --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app/static/resource/attachments/incoming /app/static/resource/attachments/outgoing /app/static/resource/attachments/raw \
    && chown -R app:app /app

COPY --from=builder /install /usr/local
COPY --chown=app:app backend/main.py backend/cronjobs.py backend/cleanup_attachments.py /app/
COPY --chown=app:app backend/configs/ /app/configs/
COPY --chown=app:app backend/routes/ /app/routes/
COPY --chown=app:app backend/orion/ /app/orion/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD ["python3", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).status == 200 else 1)"]

USER ${APP_UID}:${APP_GID}

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
