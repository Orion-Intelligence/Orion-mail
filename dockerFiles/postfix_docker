FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS base

ARG APP_UID=1000
ARG APP_GID=1000

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN echo "postfix postfix/mailname string localhost" | debconf-set-selections \
    && echo "postfix postfix/main_mailer_type string 'Internet Site'" | debconf-set-selections \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends postfix ssl-cert \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools wheel \
    && groupadd --gid "${APP_GID}" orionmail \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin orionmail \
    && usermod -aG ssl-cert postfix \
    && cp -a /etc/postfix /etc/postfix.template \
    && mkdir -p /opt/orion-mail/backend

COPY backend/postfix_incoming_handler.py /opt/orion-mail/backend/postfix_incoming_handler.py
COPY dockerFiles/postfix-entrypoint.sh /usr/local/bin/postfix-entrypoint.sh

RUN chmod 0755 /usr/local/bin/postfix-entrypoint.sh /opt/orion-mail/backend/postfix_incoming_handler.py

EXPOSE 25

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["postfix", "status"]

ENTRYPOINT ["/usr/local/bin/postfix-entrypoint.sh"]
